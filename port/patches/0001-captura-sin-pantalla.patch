+/* EonSurf: captura sin pantalla. EONSURF_SHOT=<archivo.ppm> y
+ * EONSURF_SHOT_SECS=<segundos> guardan el framebuffer (superficie ram) y salen.
+ * Idea tomada del port de Switch (solo como concepto); implementacion propia. */
+static void eonsurf_save_shot(const char *path)
+{
+	nsfb_t *nsfb = fbtk_get_nsfb(fbtk);
+	uint8_t *ptr; int linelen, w, h; enum nsfb_format_e fmt;
+	FILE *f;
+	nsfb_get_buffer(nsfb, &ptr, &linelen);
+	nsfb_get_geometry(nsfb, &w, &h, &fmt);
+	f = fopen(path, "wb");
+	if (f == NULL) return;
+	fprintf(f, "P6\n%d %d\n255\n", w, h);
+	for (int y = 0; y < h; y++) {
+		for (int x = 0; x < w; x++) {
+			uint32_t px = *(uint32_t *)(ptr + y * linelen + x * 4);
+			/* ABGR8888 en un entero de 32 bits: R en los bits altos (orden BGRA en memoria little-endian) */
+			uint8_t rgb[3] = { (px >> 16) & 0xff, (px >> 8) & 0xff, px & 0xff };
+			fwrite(rgb, 1, 3, f);
+		}
+	}
+	fclose(f);
+}
